ifeq ($(origin CC), default)
CC := clang
endif
ifeq ($(origin AR), default)
AR := ar
endif
ifeq ($(origin CXX), default)
CXX := clang++
endif
GCC ?= clang
GCC_AR ?= ar
CLANG ?= clang
CLANGXX ?= clang++
CLANG_TIDY ?= clang-tidy
GCC_ANALYZER ?= gcc
SCDOC ?= scdoc

BUILD_DIR := build
PREFIX ?= /usr/local
DESTDIR ?=
VERSION ?= 1.0.0
SANITIZERS ?= address,undefined
SANITIZER_CFLAGS ?= -fsanitize=$(SANITIZERS) -fno-omit-frame-pointer
SANITIZER_LDFLAGS ?= -fsanitize=$(SANITIZERS)
SANITIZE_BUILD_DIR ?= build-sanitize
MIRAGE_DIR ?= ../mirage
QUICKSAND_DIR ?= ../quicksand
DEPENDENCY_INCLUDE_DIRS := -I$(abspath $(MIRAGE_DIR)/include) -I$(abspath $(QUICKSAND_DIR)/include) -I$(PREFIX)/include
LOCAL_STATIC_LIBS := $(abspath $(MIRAGE_DIR)/build/libmirage.a) $(abspath $(QUICKSAND_DIR)/build/libquicksand.a)

CFLAGS_BASE := -Wall -Wextra -Wpedantic -Werror -std=c11 -fPIC \
	-ffunction-sections -fdata-sections \
	-fno-stack-protector -U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=0 \
	-Iinclude $(DEPENDENCY_INCLUDE_DIRS) -O3
CFLAGS_LTO := $(CFLAGS_BASE) -flto
CFLAGS_GCC_LTO := $(CFLAGS_BASE) -flto -Wno-pedantic
CFLAGS_SO := $(CFLAGS_BASE)

CEXE := -Wl,-dead_strip
LDFLAGS :=
CXXFLAGS := -Wall -Wextra -Wpedantic -Werror -std=c++17 -Iinclude $(DEPENDENCY_INCLUDE_DIRS) -O3

SOURCE := src/ros3.c
HEADER := include/ros3.h
COMPLETION_BASH := cmd/ros3.bash
COMPLETION_COMMANDS := rosecore rosenode rosetopic rosenet_tx rosenet_rx roseserial
PC_FILE := $(BUILD_DIR)/ros3.pc

DEP_SHARED_LIBS := -L$(PREFIX)/lib -Wl,-rpath,$(PREFIX)/lib \
	-lmirage -lquicksand
DEP_STATIC_LIBS := $(PREFIX)/lib/libmirage.a $(PREFIX)/lib/libquicksand.a
ROSETOPIC_LIBS := -lm

LIB_TARGETS := $(BUILD_DIR)/libros3.dylib $(BUILD_DIR)/libros3.a $(BUILD_DIR)/libros3_gcc_lto.a
BIN_TARGETS := \
	$(BUILD_DIR)/rosecore \
	$(BUILD_DIR)/rosenode \
	$(BUILD_DIR)/rosetopic \
	$(BUILD_DIR)/rosenet_tx \
	$(BUILD_DIR)/rosenet_rx \
	$(BUILD_DIR)/roseserial
TEST_TARGETS := \
	$(BUILD_DIR)/test \
	$(BUILD_DIR)/test_net_pub \
	$(BUILD_DIR)/test_net_sub \
	$(BUILD_DIR)/test_cpp_publisher \
	$(BUILD_DIR)/test_cpp_subscriber
ALL_EXECUTABLES := $(BIN_TARGETS) $(TEST_TARGETS)
ANALYZE_C_SOURCES := \
	src/ros3.c \
	cmd/rosecore/main+posix.c cmd/rosecore/main.c \
	cmd/rosenode/main+posix.c cmd/rosenode/main.c \
	cmd/rosetopic/main+posix.c cmd/rosetopic/main.c \
	cmd/rosenet_tx/main+posix.c cmd/rosenet_tx/main.c \
	cmd/rosenet_rx/main+posix.c cmd/rosenet_rx/main.c \
	cmd/roseserial/main+posix.c cmd/roseserial/main.c \
	cmd/test/main.c \
	cmd/test_net_pub/main.c \
	cmd/test_net_sub/main.c
ANALYZE_CPP_SOURCES := test/cpp/publisher.cpp test/cpp/subscriber.cpp
ANALYZE_CFLAGS = $(filter-out -flto -Werror -Wpedantic,$(CFLAGS_LTO))
ANALYZE_CXXFLAGS = $(filter-out -Werror -Wpedantic,$(CXXFLAGS))

MAN_PAGES := rosecore.1 rosenode.1 rosetopic.1 rosenet_tx.1 rosenet_rx.1 roseserial.1
DOC_SOURCE_DIR := docs/man/man1
DOC_BUILD_DIR := $(BUILD_DIR)/docs/man/man1
DOC_BUILD_TARGETS := $(addprefix $(DOC_BUILD_DIR)/,$(MAN_PAGES))
WEBDOC_SCRIPT := docs/web/build.sh
WEBDOC_SOURCES := $(WEBDOC_SCRIPT) docs/web/index.html docs/web/logo.svg $(wildcard docs/web/pages/*.md)

BIN_INSTALL_DIR := $(DESTDIR)$(PREFIX)/bin
LIB_INSTALL_DIR := $(DESTDIR)$(PREFIX)/lib
INCLUDE_INSTALL_DIR := $(DESTDIR)$(PREFIX)/include
PKGCONFIG_INSTALL_DIR := $(LIB_INSTALL_DIR)/pkgconfig
DOC_INSTALL_DIR := $(DESTDIR)$(PREFIX)/share/man/man1
COMPLETION_INSTALL_DIR := $(DESTDIR)$(PREFIX)/share/bash-completion/completions

ifeq ($(SANITIZE),1)
	CC := $(CLANG)
	CXX := $(CLANGXX)
	CFLAGS_BASE := $(filter-out -Werror,$(CFLAGS_BASE)) $(SANITIZER_CFLAGS)
	CFLAGS_LTO := $(CFLAGS_BASE)
	CFLAGS_GCC_LTO := $(CFLAGS_BASE) -Wno-pedantic
	CFLAGS_SO := $(CFLAGS_BASE)
	CEXE :=
	LDFLAGS := $(LDFLAGS) $(SANITIZER_LDFLAGS)
	CXXFLAGS := $(filter-out -Werror,$(CXXFLAGS)) $(SANITIZER_CFLAGS)
	DEP_STATIC_LIBS := $(LOCAL_STATIC_LIBS)
endif

# Build all libraries and executables (default target).
all: $(LIB_TARGETS) $(ALL_EXECUTABLES)

$(BUILD_DIR)/libros3.dylib: $(BUILD_DIR)/ros3_so.o
	$(CC) -dynamiclib -Wl,-install_name,@rpath/libros3.dylib -o $@ $< $(LDFLAGS) $(DEP_SHARED_LIBS)

$(BUILD_DIR)/libros3.a: $(BUILD_DIR)/ros3_lto.o
	$(AR) rcs $@ $<

$(BUILD_DIR)/libros3_gcc_lto.a: $(BUILD_DIR)/ros3_gcc_lto.o
	$(GCC_AR) rcs $@ $<

$(BUILD_DIR)/ros3_so.o: $(SOURCE)
	mkdir -p $(BUILD_DIR)
	$(CC) -c $(CFLAGS_SO) $< -o $@

$(BUILD_DIR)/ros3_lto.o: $(SOURCE)
	mkdir -p $(BUILD_DIR)
	$(CC) -c $(CFLAGS_LTO) $< -o $@

$(BUILD_DIR)/ros3_gcc_lto.o: $(SOURCE)
	mkdir -p $(BUILD_DIR)
	$(GCC) -c $(CFLAGS_GCC_LTO) $< -o $@

$(BUILD_DIR)/test: cmd/test/main.c $(BUILD_DIR)/libros3.a
	$(CC) $(CFLAGS_LTO) $(CEXE) -o $@ $< $(BUILD_DIR)/libros3.a $(DEP_STATIC_LIBS)

$(BUILD_DIR)/rosecore: cmd/rosecore/main+posix.c cmd/rosecore/main.c cmd/rosecore/core.h $(BUILD_DIR)/libros3.a
	$(CC) $(CFLAGS_LTO) $(CEXE) -o $@ cmd/rosecore/main+posix.c cmd/rosecore/main.c $(BUILD_DIR)/libros3.a $(DEP_STATIC_LIBS)

$(BUILD_DIR)/rosenode: cmd/rosenode/main+posix.c cmd/rosenode/main.c cmd/rosenode/core.h $(BUILD_DIR)/libros3.a
	$(CC) $(CFLAGS_LTO) $(CEXE) -o $@ cmd/rosenode/main+posix.c cmd/rosenode/main.c $(BUILD_DIR)/libros3.a $(DEP_STATIC_LIBS)

$(BUILD_DIR)/rosetopic: cmd/rosetopic/main+posix.c cmd/rosetopic/main.c cmd/rosetopic/core.h $(BUILD_DIR)/libros3.a
	$(CC) $(CFLAGS_LTO) $(CEXE) -o $@ cmd/rosetopic/main+posix.c cmd/rosetopic/main.c $(BUILD_DIR)/libros3.a $(DEP_STATIC_LIBS) $(ROSETOPIC_LIBS)

$(BUILD_DIR)/rosenet_tx: cmd/rosenet_tx/main+posix.c cmd/rosenet_tx/main.c cmd/rosenet_tx/core.h $(BUILD_DIR)/libros3.a
	$(CC) $(CFLAGS_LTO) $(CEXE) -o $@ cmd/rosenet_tx/main+posix.c cmd/rosenet_tx/main.c $(BUILD_DIR)/libros3.a $(DEP_STATIC_LIBS)

$(BUILD_DIR)/rosenet_rx: cmd/rosenet_rx/main+posix.c cmd/rosenet_rx/main.c cmd/rosenet_rx/core.h $(BUILD_DIR)/libros3.a
	$(CC) $(CFLAGS_LTO) $(CEXE) -o $@ cmd/rosenet_rx/main+posix.c cmd/rosenet_rx/main.c $(BUILD_DIR)/libros3.a $(DEP_STATIC_LIBS)

$(BUILD_DIR)/roseserial: cmd/roseserial/main+posix.c cmd/roseserial/main.c cmd/roseserial/core.h $(BUILD_DIR)/libros3.a
	$(CC) $(CFLAGS_LTO) $(CEXE) -o $@ cmd/roseserial/main+posix.c cmd/roseserial/main.c $(BUILD_DIR)/libros3.a $(DEP_STATIC_LIBS)

$(BUILD_DIR)/test_net_pub: cmd/test_net_pub/main.c $(BUILD_DIR)/libros3.a
	$(CC) $(CFLAGS_LTO) $(CEXE) -o $@ $< $(BUILD_DIR)/libros3.a $(DEP_STATIC_LIBS)

$(BUILD_DIR)/test_net_sub: cmd/test_net_sub/main.c $(BUILD_DIR)/libros3.a
	$(CC) $(CFLAGS_LTO) $(CEXE) -o $@ $< $(BUILD_DIR)/libros3.a $(DEP_STATIC_LIBS)

$(BUILD_DIR)/test_cpp_publisher: test/cpp/publisher.cpp $(BUILD_DIR)/libros3_gcc_lto.a
	$(CXX) $(CXXFLAGS) -o $@ $< $(BUILD_DIR)/libros3_gcc_lto.a $(DEP_STATIC_LIBS)

$(BUILD_DIR)/test_cpp_subscriber: test/cpp/subscriber.cpp $(BUILD_DIR)/libros3_gcc_lto.a
	$(CXX) $(CXXFLAGS) -o $@ $< $(BUILD_DIR)/libros3_gcc_lto.a $(DEP_STATIC_LIBS)

$(DOC_BUILD_DIR)/%.1: $(DOC_SOURCE_DIR)/%.1.scd
	mkdir -p $(DOC_BUILD_DIR)
	$(SCDOC) < $< > $@

docs: $(DOC_BUILD_TARGETS)

webdocs: $(WEBDOC_SOURCES)
	./$(WEBDOC_SCRIPT)

$(PC_FILE): Makefile.darwin
	mkdir -p $(BUILD_DIR)
	{ \
		echo "prefix=$(PREFIX)"; \
		echo 'exec_prefix=$${prefix}'; \
		echo 'libdir=$${exec_prefix}/lib'; \
		echo 'includedir=$${prefix}/include'; \
		echo; \
		echo 'Name: ros3'; \
		echo 'Description: ROS3 (Rose) publisher/subscriber middleware'; \
		echo 'Version: $(VERSION)'; \
		echo 'Libs: -L$${libdir} -lros3'; \
		echo 'Libs.private: -lmirage -lquicksand'; \
		echo 'Cflags: -I$${includedir}'; \
	} > $@

tidy:
	@set -e; \
	for src in $(ANALYZE_C_SOURCES); do \
		echo "CLANG-TIDY $$src"; \
		$(CLANG_TIDY) -quiet --extra-arg=-Wno-unused-command-line-argument $$src -- $(ANALYZE_CFLAGS); \
	done; \
	for src in $(ANALYZE_CPP_SOURCES); do \
		echo "CLANG-TIDY $$src"; \
		$(CLANG_TIDY) -quiet --extra-arg=-Wno-unused-command-line-argument $$src -- $(ANALYZE_CXXFLAGS); \
	done

clang-analyze:
	@set -e; \
	for src in $(ANALYZE_C_SOURCES); do \
		echo "CLANG-ANALYZE $$src"; \
		$(CLANG) $(ANALYZE_CFLAGS) --analyze -Xanalyzer -analyzer-output=text $$src; \
	done

fanalyzer:
	@set -e; \
	for src in $(ANALYZE_C_SOURCES); do \
		echo "FANALYZER $$src"; \
		$(GCC_ANALYZER) $(ANALYZE_CFLAGS) -fanalyzer -c $$src -o /dev/null; \
	done

check-runtime: $(BIN_TARGETS) $(BUILD_DIR)/test $(BUILD_DIR)/test_net_pub $(BUILD_DIR)/test_net_sub
	BUILD_DIR="$(abspath $(BUILD_DIR))" ./test/test_utils+darwin.sh

check-analysis:
	@set +e; \
	for target in tidy clang-analyze fanalyzer; do \
		echo "== $$target (warnings only) =="; \
		$(MAKE) --no-print-directory $$target || \
			echo "$$target reported findings; continuing to sanitizer tests"; \
	done

sanitize-deps:
	$(MAKE) -C $(MIRAGE_DIR) build/libmirage.a
	$(MAKE) -C $(QUICKSAND_DIR) build/libquicksand.a

sanitize-check: sanitize-deps
	rm -rf $(SANITIZE_BUILD_DIR)
	ASAN_OPTIONS=detect_leaks=1:strict_init_order=1:check_initialization_order=1 \
	UBSAN_OPTIONS=print_stacktrace=1:halt_on_error=1 \
	$(MAKE) BUILD_DIR=$(SANITIZE_BUILD_DIR) SANITIZE=1 check-runtime

analysis: check-analysis

check: check-analysis sanitize-check

install-bin: $(BIN_TARGETS)
	mkdir -p $(BIN_INSTALL_DIR) $(COMPLETION_INSTALL_DIR)
	install -m 0755 $(BIN_TARGETS) $(BIN_INSTALL_DIR)/
	install -m 0644 $(COMPLETION_BASH) $(COMPLETION_INSTALL_DIR)/ros3.bash
	for cmd in $(COMPLETION_COMMANDS); do install -m 0644 $(COMPLETION_BASH) $(COMPLETION_INSTALL_DIR)/$$cmd; done

install-docs:
	mkdir -p $(DOC_INSTALL_DIR)
	install -m 0644 $(DOC_BUILD_TARGETS) $(DOC_INSTALL_DIR)/

install-lib: $(LIB_TARGETS) $(PC_FILE) install-embedded
	mkdir -p $(LIB_INSTALL_DIR) $(INCLUDE_INSTALL_DIR) $(PKGCONFIG_INSTALL_DIR)
	install -m 0644 $(BUILD_DIR)/libros3.dylib $(BUILD_DIR)/libros3.a $(BUILD_DIR)/libros3_gcc_lto.a $(LIB_INSTALL_DIR)/
	install -m 0644 $(HEADER) $(INCLUDE_INSTALL_DIR)/ros3.h
	install -m 0644 $(PC_FILE) $(PKGCONFIG_INSTALL_DIR)/ros3.pc

install: install-lib install-bin

uninstall-bin:
	rm -f $(BIN_INSTALL_DIR)/rosecore $(BIN_INSTALL_DIR)/rosenode $(BIN_INSTALL_DIR)/rosetopic
	rm -f $(BIN_INSTALL_DIR)/rosenet_tx $(BIN_INSTALL_DIR)/rosenet_rx $(BIN_INSTALL_DIR)/roseserial
	rm -f $(COMPLETION_INSTALL_DIR)/ros3.bash
	rm -f $(addprefix $(COMPLETION_INSTALL_DIR)/,$(COMPLETION_COMMANDS))

uninstall-docs:
	rm -f $(addprefix $(DOC_INSTALL_DIR)/,$(MAN_PAGES))

uninstall-lib:
	rm -f $(LIB_INSTALL_DIR)/libros3.dylib $(LIB_INSTALL_DIR)/libros3.a $(LIB_INSTALL_DIR)/libros3_gcc_lto.a
	rm -f $(INCLUDE_INSTALL_DIR)/ros3.h $(INCLUDE_INSTALL_DIR)/ros3_embedded.h
	rm -f $(PKGCONFIG_INSTALL_DIR)/ros3.pc

uninstall: uninstall-lib uninstall-bin uninstall-docs

format:
	clang-format -style=file -i $$(find . | grep -e '\.c$$' -e '\.h$$')

clean:
	rm -rf $(BUILD_DIR) $(SANITIZE_BUILD_DIR)

python: $(BUILD_DIR)/libros3.dylib
	cd lang/python && pip install .

check-python: $(BUILD_DIR)/libros3.dylib
	cd lang/python && pip install --break-system-packages -e . && cd ../.. && python3 test/python/test_pubsub.py

check-cpp: $(BUILD_DIR)/rosecore $(BUILD_DIR)/test_cpp_publisher $(BUILD_DIR)/test_cpp_subscriber
	./test/test_cpp.sh

.PHONY: all check check-runtime check-analysis tidy clang-analyze fanalyzer sanitize-deps sanitize-check analysis clean docs webdocs \
	install-bin install-docs install-lib install \
	uninstall-bin uninstall-docs uninstall-lib uninstall \
	format python check-python check-cpp

include test/embedded_serial.mk
