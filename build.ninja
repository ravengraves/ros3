# ROS3 build graph
# - Library source: src
# - Public headers: include
# - CLI sources: cmd/*
# - Install root: PREFIX (default /usr/local)

cc = clang
gcc = gcc
ar = llvm-ar
gcc_ar = gcc-ar
cxx = g++
scdoc = scdoc

builddir = build
version = 1.0.0

cflags_base = -Wall -Wextra -Wpedantic -Werror -std=c11 -fPIC -ffunction-sections -fdata-sections -fno-stack-protector -D_FORTIFY_SOURCE=0 -Iinclude -O3 -mtune=native
cflags_lto = $cflags_base -flto
cflags_gcc_lto = $cflags_base -flto -Wno-pedantic
cflags_so = $cflags_base
ldflags = -fuse-ld=lld
cexe = -fuse-ld=lld -Wl,-gc-sections,-icf=safe,-s
cxxflags = -Wall -Wextra -Wpedantic -Werror -std=c++17 -Iinclude -O3 -mtune=native

rule cc_so
  command = deps_inc=$${PREFIX:-/usr/local}/include && mkdir -p $builddir && $cc -c $cflags_so -I$$deps_inc $in -o $out
  description = CC_SO $out

rule cc_lto
  command = deps_inc=$${PREFIX:-/usr/local}/include && mkdir -p $builddir && $cc -c $cflags_lto -I$$deps_inc $in -o $out
  description = CC_LTO $out

rule cc_gcc_lto
  command = deps_inc=$${PREFIX:-/usr/local}/include && mkdir -p $builddir && $gcc -c $cflags_gcc_lto -I$$deps_inc $in -o $out
  description = CC_GCC_LTO $out

rule link_so
  command = deps_lib=$${PREFIX:-/usr/local}/lib && $cc -shared -o $out $in $ldflags -L$$deps_lib -Wl,-rpath,$$deps_lib -lmirage -lquicksand
  description = LINK_SO $out

rule ar
  command = $ar rcs $out $in
  description = AR $out

rule gcc_ar
  command = $gcc_ar rcs $out $in
  description = GCC_AR $out

rule link_c
  command = deps_lib=$${PREFIX:-/usr/local}/lib deps_inc=$${PREFIX:-/usr/local}/include && $cc $cflags_lto -I$$deps_inc $cexe -o $out $in $lib $$deps_lib/libmirage.a $$deps_lib/libquicksand.a
  description = LINK_C $out

rule link_cpp
  command = deps_lib=$${PREFIX:-/usr/local}/lib deps_inc=$${PREFIX:-/usr/local}/include && $cxx $cxxflags -I$$deps_inc -o $out $in $lib $$deps_lib/libmirage.a $$deps_lib/libquicksand.a
  description = LINK_CPP $out

rule scdoc
  command = mkdir -p $$(dirname $out) && $scdoc < $in > $out
  description = SCDOC $out

rule gen_pc
  command = prefix=$${PREFIX:-/usr/local} && mkdir -p $builddir && { echo "prefix=$$prefix"; echo 'exec_prefix=$${prefix}'; echo 'libdir=$${exec_prefix}/lib'; echo 'includedir=$${prefix}/include'; echo; echo "Name: ros3"; echo "Description: ROS3 (Rose) publisher/subscriber middleware"; echo "Version: $version"; echo 'Libs: -L$${libdir} -lros3'; echo 'Libs.private: -lmirage -lquicksand'; echo 'Cflags: -I$${includedir}'; } > $out
  description = GEN_PC $out

rule run
  command = $cmd
  description = RUN $name
  pool = console
  restat = 1

build FORCE: phony

build $builddir/ros3_so.o: cc_so src/ros3.c
build $builddir/ros3_lto.o: cc_lto src/ros3.c
build $builddir/ros3_gcc_lto.o: cc_gcc_lto src/ros3.c

build $builddir/libros3.so: link_so $builddir/ros3_so.o
build $builddir/libros3.a: ar $builddir/ros3_lto.o
build $builddir/libros3_gcc_lto.a: gcc_ar $builddir/ros3_gcc_lto.o

build $builddir/rosecore: link_c cmd/rosecore/main+posix.c cmd/rosecore/core.c | $builddir/libros3.a
  lib = $builddir/libros3.a
build $builddir/rosenode: link_c cmd/rosenode/main+posix.c cmd/rosenode/core.c | $builddir/libros3.a
  lib = $builddir/libros3.a
build $builddir/rosetopic: link_c cmd/rosetopic/main+posix.c cmd/rosetopic/core.c | $builddir/libros3.a
  lib = $builddir/libros3.a
build $builddir/rosenet_tx: link_c cmd/rosenet_tx/main+posix.c cmd/rosenet_tx/core.c | $builddir/libros3.a
  lib = $builddir/libros3.a
build $builddir/rosenet_rx: link_c cmd/rosenet_rx/main+posix.c cmd/rosenet_rx/core.c | $builddir/libros3.a
  lib = $builddir/libros3.a
build $builddir/roseserial: link_c cmd/roseserial/main+posix.c cmd/roseserial/core.c | $builddir/libros3.a
  lib = $builddir/libros3.a
build $builddir/test: link_c cmd/test/main.c | $builddir/libros3.a
  lib = $builddir/libros3.a
build $builddir/test_net_pub: link_c cmd/test_net_pub/main.c | $builddir/libros3.a
  lib = $builddir/libros3.a
build $builddir/test_net_sub: link_c cmd/test_net_sub/main.c | $builddir/libros3.a
  lib = $builddir/libros3.a
build $builddir/test_cpp_publisher: link_cpp test/cpp/publisher.cpp | $builddir/libros3_gcc_lto.a
  lib = $builddir/libros3_gcc_lto.a
build $builddir/test_cpp_subscriber: link_cpp test/cpp/subscriber.cpp | $builddir/libros3_gcc_lto.a
  lib = $builddir/libros3_gcc_lto.a

build $builddir/docs/man/man1/rosecore.1: scdoc docs/man/man1/rosecore.1.scd
build $builddir/docs/man/man1/rosenode.1: scdoc docs/man/man1/rosenode.1.scd
build $builddir/docs/man/man1/rosetopic.1: scdoc docs/man/man1/rosetopic.1.scd
build $builddir/docs/man/man1/rosenet_tx.1: scdoc docs/man/man1/rosenet_tx.1.scd
build $builddir/docs/man/man1/rosenet_rx.1: scdoc docs/man/man1/rosenet_rx.1.scd
build $builddir/docs/man/man1/roseserial.1: scdoc docs/man/man1/roseserial.1.scd

build $builddir/ros3.pc: gen_pc

build .ninja-check.stamp: run FORCE | $builddir/rosecore $builddir/rosenode $builddir/rosetopic $builddir/test $builddir/rosenet_tx $builddir/rosenet_rx $builddir/test_net_pub $builddir/test_net_sub
  cmd = ./test_utils.sh && ./test_net.sh && touch .ninja-check.stamp
  name = check

build .ninja-clean.stamp: run FORCE
  cmd = mkdir -p $builddir && rm -rf $builddir/* && touch .ninja-clean.stamp
  name = clean

build .ninja-webdocs.stamp: run FORCE | docs/web/build.sh docs/web/index.html docs/web/logo.svg docs/web/pages/00-build-install.md docs/web/pages/01-project-setup.md docs/web/pages/02-pubsub-c.md docs/web/pages/03-pubsub-cpp.md docs/web/pages/04-pubsub-python.md docs/web/pages/05-tools.md docs/web/pages/06-roseserial.md docs/web/pages/07-multi-machine.md docs/web/pages/08-mirage-datatypes.md docs/web/pages/09-package-control-subtree.md
  cmd = ./docs/web/build.sh && touch .ninja-webdocs.stamp
  name = webdocs

build .ninja-install-bin.stamp: run FORCE | $builddir/rosecore $builddir/rosenode $builddir/rosetopic $builddir/rosenet_tx $builddir/rosenet_rx $builddir/roseserial
  cmd = prefix=$${PREFIX:-/usr/local}; dest=$${DESTDIR:-}; mkdir -p $$dest$$prefix/bin $$dest$$prefix/share/bash-completion/completions && install -m 0755 $builddir/rosecore $builddir/rosenode $builddir/rosetopic $builddir/rosenet_tx $builddir/rosenet_rx $builddir/roseserial $$dest$$prefix/bin/ && install -m 0644 completions/ros3.bash $$dest$$prefix/share/bash-completion/completions/ros3.bash && touch .ninja-install-bin.stamp
  name = install-bin

build .ninja-install-docs.stamp: run FORCE | $builddir/docs/man/man1/rosecore.1 $builddir/docs/man/man1/rosenode.1 $builddir/docs/man/man1/rosetopic.1 $builddir/docs/man/man1/rosenet_tx.1 $builddir/docs/man/man1/rosenet_rx.1 $builddir/docs/man/man1/roseserial.1
  cmd = prefix=$${PREFIX:-/usr/local}; dest=$${DESTDIR:-}; mkdir -p $$dest$$prefix/share/man/man1 && install -m 0644 $builddir/docs/man/man1/rosecore.1 $builddir/docs/man/man1/rosenode.1 $builddir/docs/man/man1/rosetopic.1 $builddir/docs/man/man1/rosenet_tx.1 $builddir/docs/man/man1/rosenet_rx.1 $builddir/docs/man/man1/roseserial.1 $$dest$$prefix/share/man/man1/ && touch .ninja-install-docs.stamp
  name = install-docs

build .ninja-install-lib.stamp: run FORCE | $builddir/libros3.so $builddir/libros3.a $builddir/libros3_gcc_lto.a $builddir/ros3.pc
  cmd = prefix=$${PREFIX:-/usr/local}; dest=$${DESTDIR:-}; mkdir -p $$dest$$prefix/lib $$dest$$prefix/include $$dest$$prefix/lib/pkgconfig && install -m 0644 $builddir/libros3.so $builddir/libros3.a $builddir/libros3_gcc_lto.a $$dest$$prefix/lib/ && install -m 0644 include/ros3.h $$dest$$prefix/include/ros3.h && install -m 0644 $builddir/ros3.pc $$dest$$prefix/lib/pkgconfig/ros3.pc && touch .ninja-install-lib.stamp
  name = install-lib

build .ninja-uninstall-bin.stamp: run FORCE
  cmd = prefix=$${PREFIX:-/usr/local}; dest=$${DESTDIR:-}; rm -f $$dest$$prefix/bin/rosecore $$dest$$prefix/bin/rosenode $$dest$$prefix/bin/rosetopic $$dest$$prefix/bin/rosenet_tx $$dest$$prefix/bin/rosenet_rx $$dest$$prefix/bin/roseserial $$dest$$prefix/share/bash-completion/completions/ros3.bash && touch .ninja-uninstall-bin.stamp
  name = uninstall-bin

build .ninja-uninstall-docs.stamp: run FORCE
  cmd = prefix=$${PREFIX:-/usr/local}; dest=$${DESTDIR:-}; rm -f $$dest$$prefix/share/man/man1/rosecore.1 $$dest$$prefix/share/man/man1/rosenode.1 $$dest$$prefix/share/man/man1/rosetopic.1 $$dest$$prefix/share/man/man1/rosenet_tx.1 $$dest$$prefix/share/man/man1/rosenet_rx.1 $$dest$$prefix/share/man/man1/roseserial.1 && touch .ninja-uninstall-docs.stamp
  name = uninstall-docs

build .ninja-uninstall-lib.stamp: run FORCE
  cmd = prefix=$${PREFIX:-/usr/local}; dest=$${DESTDIR:-}; rm -f $$dest$$prefix/lib/libros3.so $$dest$$prefix/lib/libros3.a $$dest$$prefix/lib/libros3_gcc_lto.a $$dest$$prefix/include/ros3.h $$dest$$prefix/lib/pkgconfig/ros3.pc && touch .ninja-uninstall-lib.stamp
  name = uninstall-lib

build all: phony $builddir/libros3.so $builddir/libros3.a $builddir/libros3_gcc_lto.a $builddir/rosecore $builddir/rosenode $builddir/rosetopic $builddir/rosenet_tx $builddir/rosenet_rx $builddir/roseserial $builddir/test $builddir/test_net_pub $builddir/test_net_sub $builddir/test_cpp_publisher $builddir/test_cpp_subscriber
build check: phony .ninja-check.stamp
build clean: phony .ninja-clean.stamp
build docs: phony $builddir/docs/man/man1/rosecore.1 $builddir/docs/man/man1/rosenode.1 $builddir/docs/man/man1/rosetopic.1 $builddir/docs/man/man1/rosenet_tx.1 $builddir/docs/man/man1/rosenet_rx.1 $builddir/docs/man/man1/roseserial.1
build webdocs: phony .ninja-webdocs.stamp

build install-bin: phony .ninja-install-bin.stamp
build install-docs: phony .ninja-install-docs.stamp
build install-lib: phony .ninja-install-lib.stamp
build install: phony install-bin install-docs install-lib

build uninstall-bin: phony .ninja-uninstall-bin.stamp
build uninstall-docs: phony .ninja-uninstall-docs.stamp
build uninstall-lib: phony .ninja-uninstall-lib.stamp
build uninstall: phony uninstall-bin uninstall-docs uninstall-lib

default all
