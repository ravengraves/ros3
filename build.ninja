# ROS3 build graph
# - Library source: src
# - Public headers: include
# - CLI sources: cmd/*
# - Install staging root: install/

cc = clang
gcc = gcc
ar = llvm-ar
gcc_ar = gcc-ar
cxx = g++
scdoc = scdoc

builddir = build
installdir = install
pc_prefix = /usr/local
version = 1.0.0

cflags_base = -Wall -Wextra -Wpedantic -Werror -std=c11 -fPIC -ffunction-sections -fdata-sections -fno-stack-protector -D_FORTIFY_SOURCE=0 -Iinclude -O3 -mtune=native
cflags_lto = $cflags_base -flto
cflags_gcc_lto = $cflags_base -flto -Wno-pedantic
cflags_so = $cflags_base
ldflags = -fuse-ld=lld
cexe = -fuse-ld=lld -Wl,-gc-sections,-icf=safe,-s
cxxflags = -Wall -Wextra -Wpedantic -Werror -std=c++17 -Iinclude -O3 -mtune=native
libs = -L/usr/local/lib -lmirage -lquicksand

rule cc_so
  command = mkdir -p $builddir && $cc -c $cflags_so $in -o $out
  description = CC_SO $out

rule cc_lto
  command = mkdir -p $builddir && $cc -c $cflags_lto $in -o $out
  description = CC_LTO $out

rule cc_gcc_lto
  command = mkdir -p $builddir && $gcc -c $cflags_gcc_lto $in -o $out
  description = CC_GCC_LTO $out

rule link_so
  command = $cc -shared -o $out $in $ldflags $libs
  description = LINK_SO $out

rule ar
  command = $ar rcs $out $in
  description = AR $out

rule gcc_ar
  command = $gcc_ar rcs $out $in
  description = GCC_AR $out

rule link_c
  command = $cc $cflags_lto $cexe -o $out $in $lib $libs
  description = LINK_C $out

rule link_cpp
  command = $cxx $cxxflags -o $out $in $lib $libs
  description = LINK_CPP $out

rule copy
  command = mkdir -p $$(dirname $out) && install -m $mode $in $out
  description = INSTALL $out

rule scdoc
  command = mkdir -p $$(dirname $out) && $scdoc < $in > $out
  description = SCDOC $out

rule gen_pc
  command = mkdir -p $builddir && { echo "prefix=$pc_prefix"; echo "exec_prefix=$pc_prefix"; echo "libdir=$pc_prefix/lib"; echo "includedir=$pc_prefix/include"; echo; echo "Name: ros3"; echo "Description: ROS3 (Rose) publisher/subscriber middleware"; echo "Version: $version"; echo "Libs: -L$pc_prefix/lib -lros3"; echo "Libs.private: -lmirage -lquicksand"; echo "Cflags: -I$pc_prefix/include"; } > $out
  description = GEN_PC $out

rule run
  command = $cmd
  description = RUN $name
  pool = console
  restat = 1

build FORCE: phony

build $builddir/ros3_so.o: cc_so src/ros3.c
build $builddir/ros3_lto.o: cc_lto src/ros3.c
build $builddir/ros3_gcc_lto.o: cc_gcc_lto src/ros3.c

build $builddir/libros3.so: link_so $builddir/ros3_so.o
build $builddir/libros3.a: ar $builddir/ros3_lto.o
build $builddir/libros3_gcc_lto.a: gcc_ar $builddir/ros3_gcc_lto.o

build $builddir/rosemaster: link_c cmd/rosemaster/main.c | $builddir/libros3.a
  lib = $builddir/libros3.a
build $builddir/rosenode: link_c cmd/rosenode/main.c | $builddir/libros3.a
  lib = $builddir/libros3.a
build $builddir/rosetopic: link_c cmd/rosetopic/main.c | $builddir/libros3.a
  lib = $builddir/libros3.a
build $builddir/rosenet_tx: link_c cmd/rosenet_tx/main.c | $builddir/libros3.a
  lib = $builddir/libros3.a
build $builddir/rosenet_rx: link_c cmd/rosenet_rx/main.c | $builddir/libros3.a
  lib = $builddir/libros3.a
build $builddir/roseserial: link_c cmd/roseserial/main.c | $builddir/libros3.a
  lib = $builddir/libros3.a
build $builddir/test: link_c cmd/test/main.c | $builddir/libros3.a
  lib = $builddir/libros3.a
build $builddir/test_net_pub: link_c cmd/test_net_pub/main.c | $builddir/libros3.a
  lib = $builddir/libros3.a
build $builddir/test_net_sub: link_c cmd/test_net_sub/main.c | $builddir/libros3.a
  lib = $builddir/libros3.a
build $builddir/test_cpp_publisher: link_cpp test/cpp/publisher.cpp | $builddir/libros3_gcc_lto.a
  lib = $builddir/libros3_gcc_lto.a
build $builddir/test_cpp_subscriber: link_cpp test/cpp/subscriber.cpp | $builddir/libros3_gcc_lto.a
  lib = $builddir/libros3_gcc_lto.a

build $builddir/docs/man/man1/rosemaster.1: scdoc docs/man/man1/rosemaster.1.scd
build $builddir/docs/man/man1/rosenode.1: scdoc docs/man/man1/rosenode.1.scd
build $builddir/docs/man/man1/rosetopic.1: scdoc docs/man/man1/rosetopic.1.scd
build $builddir/docs/man/man1/rosenet_tx.1: scdoc docs/man/man1/rosenet_tx.1.scd
build $builddir/docs/man/man1/rosenet_rx.1: scdoc docs/man/man1/rosenet_rx.1.scd
build $builddir/docs/man/man1/roseserial.1: scdoc docs/man/man1/roseserial.1.scd

build $builddir/ros3.pc: gen_pc

build $installdir/bin/rosemaster: copy $builddir/rosemaster
  mode = 0755
build $installdir/bin/rosenode: copy $builddir/rosenode
  mode = 0755
build $installdir/bin/rosetopic: copy $builddir/rosetopic
  mode = 0755
build $installdir/bin/rosenet_tx: copy $builddir/rosenet_tx
  mode = 0755
build $installdir/bin/rosenet_rx: copy $builddir/rosenet_rx
  mode = 0755
build $installdir/bin/roseserial: copy $builddir/roseserial
  mode = 0755
build $installdir/share/bash-completion/completions/ros3.bash: copy completions/ros3.bash
  mode = 0644

build $installdir/lib/libros3.so: copy $builddir/libros3.so
  mode = 0644
build $installdir/lib/libros3.a: copy $builddir/libros3.a
  mode = 0644
build $installdir/lib/libros3_gcc_lto.a: copy $builddir/libros3_gcc_lto.a
  mode = 0644
build $installdir/include/ros3.h: copy include/ros3.h
  mode = 0644
build $installdir/lib/pkgconfig/ros3.pc: copy $builddir/ros3.pc
  mode = 0644

build $installdir/share/man/man1/rosemaster.1: copy $builddir/docs/man/man1/rosemaster.1
  mode = 0644
build $installdir/share/man/man1/rosenode.1: copy $builddir/docs/man/man1/rosenode.1
  mode = 0644
build $installdir/share/man/man1/rosetopic.1: copy $builddir/docs/man/man1/rosetopic.1
  mode = 0644
build $installdir/share/man/man1/rosenet_tx.1: copy $builddir/docs/man/man1/rosenet_tx.1
  mode = 0644
build $installdir/share/man/man1/rosenet_rx.1: copy $builddir/docs/man/man1/rosenet_rx.1
  mode = 0644
build $installdir/share/man/man1/roseserial.1: copy $builddir/docs/man/man1/roseserial.1
  mode = 0644

build .ninja-check.stamp: run FORCE | $builddir/rosemaster $builddir/rosenode $builddir/rosetopic $builddir/test $builddir/rosenet_tx $builddir/rosenet_rx $builddir/test_net_pub $builddir/test_net_sub
  cmd = ./test_utils.sh && ./test_net.sh && touch .ninja-check.stamp
  name = check

build .ninja-clean.stamp: run FORCE
  cmd = mkdir -p $builddir && rm -rf $builddir/* && touch .ninja-clean.stamp
  name = clean

build .ninja-uninstall-bin.stamp: run FORCE
  cmd = rm -f $installdir/bin/rosemaster $installdir/bin/rosenode $installdir/bin/rosetopic $installdir/bin/rosenet_tx $installdir/bin/rosenet_rx $installdir/bin/roseserial $installdir/completions/bash/ros3.bash $installdir/share/bash-completion/completions/ros3.bash && touch .ninja-uninstall-bin.stamp
  name = uninstall-bin

build .ninja-uninstall-docs.stamp: run FORCE
  cmd = rm -f $installdir/share/man/man1/rosemaster.1 $installdir/share/man/man1/rosenode.1 $installdir/share/man/man1/rosetopic.1 $installdir/share/man/man1/rosenet_tx.1 $installdir/share/man/man1/rosenet_rx.1 $installdir/share/man/man1/roseserial.1 && touch .ninja-uninstall-docs.stamp
  name = uninstall-docs

build .ninja-uninstall-lib.stamp: run FORCE
  cmd = rm -f $installdir/lib/libros3.so $installdir/lib/libros3.a $installdir/lib/libros3_gcc_lto.a $installdir/include/ros3.h $installdir/lib/pkgconfig/ros3.pc && touch .ninja-uninstall-lib.stamp
  name = uninstall-lib

build all: phony $builddir/libros3.so $builddir/libros3.a $builddir/libros3_gcc_lto.a $builddir/rosemaster $builddir/rosenode $builddir/rosetopic $builddir/rosenet_tx $builddir/rosenet_rx $builddir/roseserial $builddir/test $builddir/test_net_pub $builddir/test_net_sub $builddir/test_cpp_publisher $builddir/test_cpp_subscriber
build check: phony .ninja-check.stamp
build clean: phony .ninja-clean.stamp
build docs: phony $builddir/docs/man/man1/rosemaster.1 $builddir/docs/man/man1/rosenode.1 $builddir/docs/man/man1/rosetopic.1 $builddir/docs/man/man1/rosenet_tx.1 $builddir/docs/man/man1/rosenet_rx.1 $builddir/docs/man/man1/roseserial.1

build install-bin: phony $installdir/bin/rosemaster $installdir/bin/rosenode $installdir/bin/rosetopic $installdir/bin/rosenet_tx $installdir/bin/rosenet_rx $installdir/bin/roseserial $installdir/share/bash-completion/completions/ros3.bash
build install-docs: phony $installdir/share/man/man1/rosemaster.1 $installdir/share/man/man1/rosenode.1 $installdir/share/man/man1/rosetopic.1 $installdir/share/man/man1/rosenet_tx.1 $installdir/share/man/man1/rosenet_rx.1 $installdir/share/man/man1/roseserial.1
build install-lib: phony $installdir/lib/libros3.so $installdir/lib/libros3.a $installdir/lib/libros3_gcc_lto.a $installdir/include/ros3.h $installdir/lib/pkgconfig/ros3.pc
build install: phony install-bin install-docs install-lib

build uninstall-bin: phony .ninja-uninstall-bin.stamp
build uninstall-docs: phony .ninja-uninstall-docs.stamp
build uninstall-lib: phony .ninja-uninstall-lib.stamp
build uninstall: phony uninstall-bin uninstall-docs uninstall-lib

default all
